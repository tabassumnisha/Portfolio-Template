# Creative Portfolio CMS — configuration. Copy this file to ".env" and edit it:   cp .env.example .env
# The server reads ".env" at start-up (real environment variables override it). Never commit ".env".
# Every value below is a placeholder or a safe default.

# --- Server ---------------------------------------------------------------
PORT=3000
HOST=0.0.0.0
# Folder for the SQLite database and uploaded images. Back this folder up.
DATA_DIR=data

# --- First administrator (used ONCE, only while no user exists) -------------
# Choose your own e-mail and a long password (10+ characters), start the server once,
# then DELETE the ADMIN_PASSWORD line. Or leave both empty and run:  npm run create-admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# --- Sessions and cookies ---------------------------------------------------
SESSION_HOURS=12
# auto = mark the cookie "Secure" when the request is HTTPS. Use "true" in production behind HTTPS.
COOKIE_SECURE=auto
# Set to true ONLY when the app runs behind a reverse proxy you control (nginx, Caddy, a PaaS router)
# that sets X-Forwarded-For / X-Forwarded-Proto. Needed for correct rate limiting and HTTPS detection.
TRUST_PROXY=false

# --- Uploads and sample data -------------------------------------------------
MAX_UPLOAD_MB=5
# Fill an empty database with the placeholder portfolio from database/seed.sql (true/false).
SEED_SAMPLE_DATA=true
# Per-IP limits on login, contact form and uploads (true/false). Keep this on.
RATE_LIMIT=true
