# ============================================================================
# .env.example — every configuration variable of the Portfolio CMS
#
# Copy this file to .env (never commit .env) and replace every CHANGE_ME value
# before the first start. Real environment variables override values in .env.
# ============================================================================

# Network interface the server listens on. Use 127.0.0.1 behind a reverse proxy on the same machine, 0.0.0.0 for Docker or a public interface.
HOST=0.0.0.0

# TCP port of the server inside the process (Docker maps it to PORTFOLIO_PORT).
PORT=8080

# SQLite database file. Created automatically on the first start; the folder also holds uploaded images (uploads/). Back this folder up.
DATABASE_PATH=./data/portfolio.sqlite3

# E-mail address of the first administrator. The account is created only when the database has no admin yet.
ADMIN_EMAIL=admin@example.com

# Bootstrap password for the first administrator: 14+ characters, unique. Remove this line after the first start and change the password in the admin panel.
ADMIN_PASSWORD=CHANGE_ME_USE_A_UNIQUE_LONG_PASSWORD

# Secret that signs the session cookie. Generate: python3 -c "import secrets; print(secrets.token_hex(32))". Admin sign-in stays disabled until this is set.
SESSION_SECRET=CHANGE_ME_GENERATE_AT_LEAST_32_RANDOM_BYTES

# Set to true when the site is served over HTTPS so the session cookie is only sent over HTTPS.
COOKIE_SECURE=false

# Host port used by Docker Compose only (docker-compose.yml maps it to the container's port 8080).
PORTFOLIO_PORT=8080
