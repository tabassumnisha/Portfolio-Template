# ============================================================================
# .env.example — every configuration value of the Portfolio Template
#
# IMPORTANT: this template is frontend-only and has no server code, so it does NOT
# read a .env file at runtime. The live values are set in Project/config.example.js
# (window.SITE_CONFIG), which is public to every visitor. This file lists every
# setting with a placeholder and a comment, so you can see them all in one place.
# Never put passwords, API keys or private URLs here or in config.example.js.
# Do not commit a real .env.
# ============================================================================

# --- Owner / branding (SITE_CONFIG.owner) ------------------------------------
OWNER_NAME="Your Name"                      # Full name; the last word is highlighted in the hero title
OWNER_INITIALS="YN"                         # Brand mark in the header (1-3 letters)
OWNER_ROLE="Graphic Designer & Digital Creator"   # Job title under the hero name
OWNER_INTRO="I create visually stunning designs that bring ideas to life."   # Hero paragraph
OWNER_ABOUT="I'm Your Name, a passionate designer with a strong eye for detail."   # About paragraph
OWNER_TAGLINE="Turning ideas into visual stories with creativity and purpose."   # Line under "About Me"
OWNER_QUOTE="Design is not just what it looks like and feels like. Design is how it works."   # Quote card
OWNER_LOCATION="Your City, Country"         # Location in the info bar and contact list
OWNER_EXPERIENCE="2+ Years"                 # Experience in the info bar

# --- Images (SITE_CONFIG.images, paths relative to Project/index.html) -------
IMAGE_HERO="assets/images/portrait-placeholder.webp"   # Transparent cut-out portrait, about 1000x1307
IMAGE_ABOUT="assets/images/about-photo.jpg"            # About polaroid portrait, 4:5, about 960x1200

# --- Contact (SITE_CONFIG.contact) -------------------------------------------
CONTACT_WHATSAPP_NUMBER="+10000000000"      # International format; digits are extracted for wa.me
CONTACT_WHATSAPP_GREETING="Hello! I found your portfolio and would like to discuss a project."   # Prefilled WhatsApp text
CONTACT_EMAIL="hello@example.com"           # Shown on the page and used for mailto:
CONTACT_WEBSITE="https://example.com"       # Shown in the footer

# --- Social profiles (SITE_CONFIG.social): leave empty to hide that icon -----
SOCIAL_FACEBOOK="https://example.com/yourname"
SOCIAL_X="https://example.com/yourname"
SOCIAL_INSTAGRAM="https://example.com/yourname"
SOCIAL_GITHUB="https://example.com/yourname"
SOCIAL_TELEGRAM="https://example.com/yourname"
SOCIAL_REDDIT="https://example.com/yourname"

# --- Page text (SITE_CONFIG.site) --------------------------------------------
SITE_TITLE="Your Name — Designer & Creative Professional"   # Browser tab title (also edit <title> in index.html)
SITE_DESCRIPTION="Responsive creative portfolio for designers and freelancers."   # Meta / Open Graph description
SITE_FOOTER_QUOTE="Good Design is Good Business"   # Footer quote
SITE_FORM_NOTE="Clicking Send Message opens WhatsApp with your message. Nothing is stored or sent to a server."   # Note under the contact form

# --- Docker (docker-compose.yml only) ----------------------------------------
PORTFOLIO_PORT=8080                         # Host port for the nginx container; copy this file to .env for docker compose to read it
